# -----------------------------------------------------------------------------
# Project-specific Git ignore rules
# -----------------------------------------------------------------------------

# -------------------------
# Local environment / secrets
# -------------------------
.env
.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample
!**/.env.development.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.token
*.secret
*.local
*.local.*

# Backend environment folder is local-only, but keep the example templates tracked
itds_env/.env
itds_env/.env.*
!itds_env/.env.example
!itds_env/smtp_example.env

# Frontend local config
itds_env/frontend/.env
itds_env/frontend/.env.*
!itds_env/frontend/.env.development.example

# -------------------------
# Python virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
__pypackages__/

# These are generated by the local Python environment and stay out of Git
itds_env/Include/
itds_env/Lib/
itds_env/Scripts/
itds_env/share/
itds_env/pyvenv.cfg
itds_env/dist_metrics.pxd

# -------------------------
# Python caches and tooling
# -------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# -------------------------
# Node / frontend artifacts
# -------------------------
node_modules/
**/node_modules/
.npm/
.pnpm-store/
coverage/

# Frontend build outputs
build/
dist/
out/
.next/
.cache/
**/.cache/

# -------------------------
# Logs, temp files, downloads, scratch work
# -------------------------
*.log
*.log.*
app.log*
logs/
log/
tmp/
temp/
tmp.*
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej
*.pid

# Local database and persisted app data
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
itds_env/*.db
itds_env/*.db-journal
itds_env/*.db-shm
itds_env/*.db-wal
itds_env/uploads/
itds_env/logs/
itds_env/scratch/

# Application runtime uploads
uploads/
uploads/**
!uploads/.gitkeep

# -------------------------
# OS / editor / personal config
# -------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# -------------------------
# Packaging / archives
# -------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar

# -------------------------
# Generated artifacts that are safe to recreate locally
# -------------------------
site-packages/
*/site-packages/

# Keep local sample environment files for collaborators to copy from
!itds_env/.env.example
!itds_env/smtp_example.env
!itds_env/frontend/.env.development.example
