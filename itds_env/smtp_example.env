# Copy to itds_env/.env and FILL YOUR CREDS&#10;&#10;# Gmail SMTP (recommended)&#10;SMTP_SERVER=smtp.gmail.com&#10;SMTP_PORT=587&#10;SMTP_USERNAME=yourapp@gmail.com&#10;SMTP_PASSWORD=abcd1234efgh5678  # ← Gmail App Password (16 chars)&#10;FROM_EMAIL=yourapp@gmail.com&#10;&#10;# App Secrets&#10;SECRET_KEY=super-secret-key-change-this-32-chars-long&#10;JWT_SECRET_KEY=jwt-secret-must-be-secure&#10;&#10;# Get Gmail App Password:&#10;# 1. Enable 2FA on Gmail&#10;# 2. Google Account → Security → App Passwords&#10;# 3. Generate "Mail" app → copy 16 chars
