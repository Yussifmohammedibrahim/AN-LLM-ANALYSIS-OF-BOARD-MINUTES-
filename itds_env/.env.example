# SMTP configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# Gemini API key (Required for LLM-based operations)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (Optional: used for narrative summaries fallback)
OPENAI_API_KEY=your_openai_api_key_here

# AI configuration
AI_TEMPERATURE=0.35

# Application security (replace with long secure random strings in production)
SECRET_KEY=replace-with-a-secure-random-32-char-string
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-key

# Hugging Face token (Optional: recommended for raising model API limits)
HF_TOKEN=your_hugging_face_token_here

# Queue backend for AI batch jobs (defaults to redis)
REDIS_URL=redis://localhost:6379/0

# Web push notifications keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# Dependency tool paths (adjust based on host machine architecture)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
FFMPEG_CMD=ffmpeg

# Audio processing settings
ITDS_AUDIO_MAX_SECONDS=120
ITDS_AUDIO_SILENCE_THRESHOLD=0.012
ITDS_AUDIO_MIN_SPEECH_SECONDS=0.20
ITDS_ASR_CHUNK_LENGTH_S=20
ITDS_ASR_BATCH_SIZE=8
ITDS_ASR_MODEL=openai/whisper-tiny.en

# Model selections
ITDS_NER_MODEL=dbmdz/bert-large-cased-finetuned-conll03-english
ITDS_QA_MODEL=distilbert-base-cased-distilled-squad
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_MODEL_FALLBACKS=distilbert-base-uncased-finetuned-sst-2-english
SUMMARIZER_MODEL=philschmid/bart-large-cnn-samsum
SUMMARIZER_MODEL_FALLBACKS=facebook/bart-large-cnn,google/pegasus-xsum
TOPIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ZERO_SHOT_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
ZERO_SHOT_MODEL_FALLBACKS=facebook/bart-large-mnli,typeform/distilbert-base-uncased-mnli
